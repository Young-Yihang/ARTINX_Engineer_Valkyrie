# PlanAndExecute.srv - Service for planning and executing trajectories with retry logic
# This service provides a high-level interface for STM32 or other clients to request
# motion planning with automatic retry on failure.

# Request
geometry_msgs/PoseStamped target_pose  # Target end-effector pose
bool use_vision_servoing               # Optional: Enable vision servoing mode (future use)

---

# Response
bool success                           # True if planning and execution succeeded
string error_code                      # Error classification:
                                       #   - "SUCCESS": Trajectory planned and sent to execution
                                       #   - "NO_IK_SOLUTION": Target unreachable (IK failed)
                                       #   - "PLANNING_TIMEOUT": Planner exhausted time
                                       #   - "COLLISION_UNAVOIDABLE": Scene too cluttered
                                       #   - "MAX_RETRIES_EXCEEDED": All attempts failed
                                       #   - "EXECUTION_FAILED": Trajectory planned but controller error
int32 attempts_used                    # Number of planning attempts made (1-3)
float64 planning_time                  # Total time spent planning (seconds)
