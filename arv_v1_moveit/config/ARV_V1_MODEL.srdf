<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="ARV_V1_MODEL">
    <!--GROUPS-->
    <group name="ARM">
        <chain base_link="base_link" tip_link="link6"/>
    </group>
    <!--GROUP STATES: 新臂初始位置待标定后更新 -->
    <group_state name="Escape" group="ARM">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="0"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="0"/>
        <joint name="joint_6" value="0"/>
    </group_state>
    <group_state name="Start" group="ARM">
        <joint name="joint_1" value="0"/>
        <joint name="joint_2" value="0"/>
        <joint name="joint_3" value="0"/>
        <joint name="joint_4" value="0"/>
        <joint name="joint_5" value="0"/>
        <joint name="joint_6" value="0"/>
    </group_state>
    <!--VIRTUAL JOINT-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: 基于新臂连杆结构生成，建议后续用 Setup Assistant 重新生成完整碰撞矩阵 -->
    <!-- 相邻连杆（必然接触） -->
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="link_gripper1" reason="Adjacent"/>
    <disable_collisions link1="link6" link2="link_gripper2" reason="Adjacent"/>
    <disable_collisions link1="link_gripper1" link2="link_gripper2" reason="Adjacent"/>
    <!-- 几何上不可能碰撞的连杆对 -->
    <disable_collisions link1="base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link2" link2="link4" reason="Never"/>
    <disable_collisions link1="link3" link2="link5" reason="Never"/>
    <disable_collisions link1="link3" link2="link6" reason="Never"/>
    <disable_collisions link1="link4" link2="link6" reason="Never"/>
    <disable_collisions link1="link3" link2="link_gripper1" reason="Never"/>
    <disable_collisions link1="link3" link2="link_gripper2" reason="Never"/>
</robot>
